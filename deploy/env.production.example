# Copy to /opt/romka/.env — NEVER commit real values.
ENVIRONMENT=production
APP_NAME=ROMKA
SECRET_KEY=CHANGE_ME_WITH_48_RANDOM_BYTES
DATABASE_URL=postgresql+psycopg://romka:CHANGE_ME@localhost:5432/romka
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800
RATE_LIMIT_PER_MINUTE=60
ROMKA_AUTO_DEMO=false
# Set these only if you deliberately keep a demo account; never in public.
ROMKA_DEMO_EMAIL=
ROMKA_DEMO_PASSWORD=

AI_PRIMARY_PROVIDER=local
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_ALLOW_FALLBACK=false
AI_DAILY_BUDGET_USD=1.00
AI_MONTHLY_BUDGET_USD=20.00
AI_ALLOW_SENSITIVE_TO_EXTERNAL=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=
BALE_API_BASE_URL=https://tapi.bale.ai
