# ── ROMKA configuration sample. Copy to .env (never commit .env) ──
ENVIRONMENT=development
APP_NAME=ROMKA
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# SQLite for local/Windows dev; PostgreSQL on the VPS:
# DATABASE_URL=postgresql+psycopg://romka:CHANGE_ME@localhost:5432/romka
DATABASE_URL=sqlite:///./romka.db
COOKIE_SECURE=false
# auto = SameSite=None; Secure when served over HTTPS (needed for embedded
# previews/iframes), SameSite=Lax on plain HTTP. Also: lax | strict | none.
COOKIE_SAMESITE=auto
SESSION_MAX_AGE_SECONDS=604800
RATE_LIMIT_PER_MINUTE=90

# ── AI providers ──
# "local" = offline deterministic provider (no key, fully testable)
# "openai_compatible" = any OpenAI-compatible /chat/completions endpoint
# "gapgpt" = preset for https://api.gapgpt.app/v1 (docs verified 2026-10-28)
AI_PRIMARY_PROVIDER=local
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=romka-local-v1
# 0 = use the built-in conservative USD estimate for budget caps.
AI_PRIMARY_PRICE_PER_MILLION_USD=0
AI_FALLBACK_PRICE_PER_MILLION_USD=0
# GapGPT preset values (used when AI_PRIMARY_PROVIDER=gapgpt)
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_DEFAULT_MODEL=gpt-4o-mini

# ── GapGPT example (uncomment, then press "تست اتصال" in /settings) ──
# AI_PRIMARY_PROVIDER=gapgpt
# AI_PRIMARY_API_KEY=YOUR_GAPGPT_KEY      # never commit this file with a real key
# GAPGPT_DEFAULT_MODEL=gpt-4o-mini
# AI_DAILY_BUDGET_USD=0.50
# AI_MONTHLY_BUDGET_USD=10.00
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_ALLOW_FALLBACK=false
AI_DAILY_BUDGET_USD=1.00
AI_MONTHLY_BUDGET_USD=20.00
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=30
AI_MAX_CALLS_PER_REQUEST=3
AI_MAX_AGENT_STEPS=6
# Privacy: sensitive memory layers are never sent to external providers.
AI_ALLOW_SENSITIVE_TO_EXTERNAL=false

# ── Messaging channels (optional; empty = disabled) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=
# Official docs: https://docs.bale.ai/  (Telegram-compatible, base tapi.bale.ai)
BALE_API_BASE_URL=https://tapi.bale.ai

# ── Dev-only convenience (NEVER enable on a public instance) ──
ROMKA_AUTO_DEMO=true
ROMKA_DEMO_EMAIL=demo@romka.local
ROMKA_DEMO_PASSWORD=RomkaDemo2026!
ROMKA_DEMO_SEED_DATA=true
